# Supabase PostgreSQL Connection String
# e.g., postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payrescue"

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Admin gate for mutating APIs (recovery execute, demo seeds, eval, recon run).
# Required in production; all protected routes expect header: x-admin-secret: <value>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="change_me_to_a_long_random_string"

# Cron authentication (Vercel). Set CRON_SECRET in Vercel env and Vercel will
# automatically send it as `Authorization: Bearer <CRON_SECRET>` on every
# cron hit to /api/agent/run. Same generator as above; must differ from ADMIN_SECRET.
CRON_SECRET="change_me_to_another_long_random_string"

# Optional: LLM key for the future "diagnosis with citations" upgrade
# (see AI_ROADMAP.md item 1). Not required — the rule engine is the default.
# LLM_API_KEY="sk-..."
